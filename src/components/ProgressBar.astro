<!--
  Thin reading-progress bar pinned to the top of the viewport.
  Fills left→right as the reader scrolls through <article>.
  Only rendered inside BlogPost layout.
-->
<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress-bar" id="reading-progress-bar"></div>
</div>

<script>
  import { onPage } from '../utils/vt';

  onPage((signal) => {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    function update() {
      const article = document.querySelector('article');
      if (!article) return;
      const rect = article.getBoundingClientRect();
      const total = article.scrollHeight - window.innerHeight;
      if (total <= 0) { bar.style.transform = 'scaleX(0)'; return; }
      const scrolled = Math.min(Math.max(-rect.top, 0), total);
      bar.style.transform = `scaleX(${scrolled / total})`;
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal });
    window.addEventListener('resize', onScroll, { passive: true, signal });
    update();
  });
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 9999;
    pointer-events: none;
  }
  .reading-progress-bar {
    height: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: linear-gradient(90deg, #b08968, #ddb892);
    transition: transform 80ms linear;
  }
  html.dark .reading-progress-bar {
    background: linear-gradient(90deg, #ddb892, #e6ccb2);
  }
</style>
