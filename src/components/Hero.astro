---
import { SITE_CONFIG } from "../config";

const { name, bio, tagline, avatar, social } = SITE_CONFIG;
---

<section class="hero-section">
  <div class="hero-content">
    <div class="hero-main">
      <div class="avatar-wrapper">
        <img src={avatar} alt={name} class="avatar" />
      </div>

      <h1 class="hero-name">{name}'s Blog</h1>
      <p class="hero-tagline" set:html={tagline} />
    </div>

    <div class="hero-sidebar">
      <div class="social-links">
        {
          social.email && (
            <a
              href={`mailto:${social.email}`}
              class="social-link"
              title="Email"
              aria-label="Email"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </a>
          )
        }

        {
          social.github && (
            <a
              href={social.github}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              title="GitHub"
              aria-label="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
            </a>
          )
        }

        {
          social.twitter && (
            <a
              href={social.twitter}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              title="Twitter"
              aria-label="Twitter"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
              </svg>
            </a>
          )
        }

        {
          social.linkedin && (
            <a
              href={social.linkedin}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              title="LinkedIn"
              aria-label="LinkedIn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            </a>
          )
        }
      </div>

      <div class="hero-bio">
        {bio.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    padding: 6rem 1rem 4rem;
    margin-bottom: 2rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .hero-main {
    animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
  }

  /* Sidebar vertically centres against the taller main column, so the social
     row lands beside the name without any hard-coded pixel offset. */
  .hero-sidebar {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes hero-pop {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes hero-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(128, 128, 128, 0); }
    50%      { box-shadow: 0 0 0 7px rgba(128, 128, 128, 0.06); }
  }

  .avatar-wrapper {
    margin-bottom: 1.8rem;
    animation: hero-pop 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(128, 128, 128, 0.2);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
    animation: hero-glow 6s ease-in-out 1s infinite;
  }

  .avatar:hover {
    transform: scale(1.05);
    border-color: rgba(128, 128, 128, 0.4);
  }

  .hero-name {
    font-family: "et-book", serif;
    font-size: 3.2rem;
    font-weight: normal;
    line-height: 1;
    margin: 0 0 1.4rem 0;
  }

  .hero-bio {
    font-family: "et-book", serif;
    font-size: 1.4rem;
    line-height: 2rem;
    margin: 0;
  }

  .hero-bio p {
    margin: 0;
  }

  .hero-tagline {
    font-family: "et-book", serif;
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.6;
    margin: 0;
    opacity: 0.8;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: inherit;
    background: rgba(128, 128, 128, 0.15);
    border-radius: 50%;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    background: rgba(128, 128, 128, 0.3);
    transform: translateY(-2px);
  }

  .social-link:focus-visible {
    outline: 2px solid rgba(128, 128, 128, 0.5);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-main,
    .hero-sidebar,
    .avatar-wrapper,
    .avatar {
      animation: none !important;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 1rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-sidebar {
      align-self: start;
    }

    .hero-name {
      font-size: 2.5rem;
    }

    .hero-bio {
      font-size: 1.2rem;
      line-height: 1.8rem;
    }

    .hero-tagline {
      font-size: 1.2rem;
      line-height: 1.6rem;
    }

    .avatar {
      width: 100px;
      height: 100px;
    }
  }
</style>
