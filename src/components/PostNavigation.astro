---
type PostLink = { title: string; id: string };

interface Props {
	previous?: PostLink;
	next?: PostLink;
	hrefBase: '/blog' | '/daily';
}

const { previous, next, hrefBase } = Astro.props;
---

{(previous || next) && (
	<nav class="post-nav" aria-label="Post navigation">
		{previous ? (
			<a href={`${hrefBase}/${previous.id}/`} class="post-nav-link post-nav-prev">
				<span class="post-nav-dir">← Previous</span>
				<span class="post-nav-title">{previous.title}</span>
			</a>
		) : (
			<span />
		)}
		{next ? (
			<a href={`${hrefBase}/${next.id}/`} class="post-nav-link post-nav-next">
				<span class="post-nav-dir">Next →</span>
				<span class="post-nav-title">{next.title}</span>
			</a>
		) : (
			<span />
		)}
	</nav>
)}

<style>
	.post-nav {
		width: 60%;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid #ccc;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		font-family: 'et-book', serif;
	}
	html.dark .post-nav {
		border-top-color: rgba(221, 221, 221, 0.3);
	}

	.post-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease;
	}
	.post-nav-next {
		text-align: right;
		align-items: flex-end;
	}
	.post-nav-link:hover {
		transform: translateY(-2px);
	}

	.post-nav-dir {
		font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #999;
	}

	.post-nav-title {
		font-size: 1.3rem;
		font-style: italic;
		line-height: 1.3;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.15em;
		transition: text-decoration-color 0.2s ease;
	}
	.post-nav-link:hover .post-nav-title {
		text-decoration-color: currentColor;
	}

	@media (max-width: 760px) {
		.post-nav {
			width: 100%;
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.post-nav-next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
