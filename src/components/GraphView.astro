---
/**
 * GraphView — the note graph as a full-screen star chart overlay, opened
 * from the star button in the header (SkyToggle) and dismissed with the
 * same circular reveal the theme toggle uses. Rendered on the home page
 * only; the overlay itself is fixed and covers the viewport while open.
 *
 * Data is baked in at build time from src/data/graph.json (emitted by
 * scripts/graph-build.mjs locally, or scripts/publish.py in CI). If that
 * file is absent the overlay and its toggle render nothing.
 *
 * Interactions (unchanged from the original graph): nodes sized by degree
 * and tinted by first tag. Dark mode draws them as warm stars over
 * sepia towns with place-name labels and ink roads, framed by a fixed
 * screen-space plate (double frame + compass rose) that never moves while
 * the map pans and zooms underneath it; anything outside the frame is
 * clipped away and labels stay on for every town inside it. Ghost
 * (unpublished) notes render hollow in both; hover
 * highlights the neighborhood; drag nodes to rearrange; drag the
 * background to pan; scroll/pinch or the corner buttons to zoom; click a
 * published node to navigate. The layout is pre-settled synchronously
 * and auto-fitted until the user takes over the camera. Esc or the close
 * button dismisses. Follows the dark-mode class; re-initializes on View
 * Transition navigations.
 */
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';

let graphData: { nodes: any[]; links: any[] } | null = null;
const dataPath = resolve(process.cwd(), 'src/data/graph.json');
if (existsSync(dataPath)) {
	try {
		graphData = JSON.parse(readFileSync(dataPath, 'utf-8'));
	} catch {
		graphData = null;
	}
}
// Escape "<" so a "</script>" inside a title can't terminate the block.
const graphJson = graphData ? JSON.stringify(graphData).replace(/</g, '\u003c') : '';
---

{graphData && graphData.nodes?.length > 0 && (
	<div class="skyfield" hidden>
		<canvas class="gv-canvas" aria-label="Interactive note graph"></canvas>
		<div class="gv-zoom">
			<button class="gv-btn" data-act="in" aria-label="Zoom in" title="Zoom in">+</button>
			<button class="gv-btn" data-act="out" aria-label="Zoom out" title="Zoom out">−</button>
			<button class="gv-btn" data-act="fit" aria-label="Fit graph to view" title="Fit to view">⤢</button>
			<span class="gv-zoom-pct" aria-hidden="true">100%</span>
		</div>
		<button class="sky-close" aria-label="Close star chart" title="Close (Esc)">×</button>
		<p class="sky-hint">drag a star · drag the sky to pan · scroll or pinch to zoom · click a star to open · esc to close</p>
		<div class="gv-tip" hidden></div>
		<script type="application/json" id="gv-data" set:html={graphJson} />
	</div>
)}

<script>
	import { onPage } from '../utils/vt';

	const d3Ready = () =>
		new Promise<void>((resolve) => {
			if (window.d3?.forceSimulation) return resolve();
			const s = document.createElement('script');
			s.src = '/scripts/d3-force.min.js';
			s.onload = () => resolve();
			s.onerror = () => resolve(); // degrade silently if the bundle fails
			document.head.appendChild(s);
		});

	// Dark mode reads as a warm night sky; light mode trades the sky for an
	// antique atlas page — sepia towns, ink roads and a framed plate on parchment.
	const INK_COLORS = [
		'#b08968', '#8a6d4f', '#a9714b', '#7f5539',
		'#9c6644', '#6f4e37', '#8d6e63', '#c08552',
	];
	const STAR_COLORS = [
		'#ffd9a0', '#f0b97a', '#e8c89a', '#dda15f',
		'#f5e0b8', '#e0a870', '#d9b48a', '#ffc98a',
	];

	function colorIndex(group) {
		if (!group) return -1;
		let h = 0;
		for (let i = 0; i < group.length; i++) h = (h * 31 + group.charCodeAt(i)) | 0;
		return Math.abs(h) % INK_COLORS.length;
	}

	function themeColors() {
		const dark = document.documentElement.classList.contains('dark');
		return dark ? {
			link: 'rgba(232, 210, 176, 0.13)',
			linkHi: 'rgba(255, 217, 160, 0.72)',
			label: '#e8e2d5',
			fade: 0.22,
			dust: 'rgba(221, 184, 146, 1)',
			ghost: 'rgba(221, 214, 200, 0.4)',
			stars: STAR_COLORS,
			noGroup: '#cfc6b4',
			core: '#fff6e6',
			haloA: 0.34,
			map: false,
		} : {
			link: 'rgba(120, 100, 80, 0.30)',
			linkHi: 'rgba(140, 100, 60, 0.75)',
			label: '#2b2620',
			fade: 0.18,
			dust: 'rgba(120, 100, 80, 1)',
			ghost: 'rgba(140, 130, 115, 0.6)',
			stars: INK_COLORS,
			noGroup: '#8d8577',
			core: null,
			haloA: 0,
			map: true,
			ink: '#4a3a28',
			labelMinor: 'rgba(74, 58, 40, 0.8)',
			labelHub: 'rgba(52, 40, 26, 0.95)',
			frame: 'rgba(110, 88, 62, 0.5)',
			frameIn: 'rgba(110, 88, 62, 0.3)',
			compass: 'rgba(110, 88, 62, 0.6)',
			scale: 'rgba(90, 70, 48, 0.55)',
	};
	}

	function init(signal) {
		const root = document.querySelector('.skyfield');
		if (!root) return;
		const canvas = root.querySelector('.gv-canvas');
		const tip = root.querySelector('.gv-tip');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');

		const dataEl = root.querySelector('#gv-data');
		let data = null;
		try { data = JSON.parse(dataEl.textContent); } catch { /* fall through */ }
		if (!data || !data.nodes?.length) { root.remove(); return; }

		let width = 0, height = 0, dpr = 1;
		const nodes = data.nodes;
		const links = data.links;
		for (const n of nodes) {
			n.ci = colorIndex(n.group);
			n.twPhase = Math.random() * Math.PI * 2;
			n.twSpeed = 0.25 + Math.random() * 0.5;
		}
		let sim = null;
		let started = false; // sim built on first open
		let hoverNode = null;
		let dragNode = null;
		let dragged = false;
		// Camera: screen = world * k + offset (CSS px).
		const cam = { x: 0, y: 0, k: 1 };
		const K_MIN = 0.35, K_MAX = 3;
		let touched = false; // user moved the camera → stop auto-fitting
		let panning = null; // { startX, startY, camX, camY } while background-dragging
		const pointers = new Map(); // pointerId -> {cx, cy} for pinch tracking
		const pinch = { dist: 0, mx: 0, my: 0 };
		const neighbors = new Map(); // id -> Set(id)
		for (const l of links) {
			const s = typeof l.source === 'object' ? l.source.id : l.source;
			const t = typeof l.target === 'object' ? l.target.id : l.target;
			if (!neighbors.has(s)) neighbors.set(s, new Set());
			if (!neighbors.has(t)) neighbors.set(t, new Set());
			neighbors.get(s).add(t);
			neighbors.get(t).add(s);
		}

		// --- antique-atlas chrome (light mode only) --------------------------
		// The plate (double frame + compass rose) is a fixed screen-space
		// picture frame: the graph pans and zooms underneath it, and anything
		// outside the frame is clipped away.
		let atlasBounds = null;
		function buildAtlas() {
			let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
			for (const n of nodes) {
				if (!Number.isFinite(n.x) || !Number.isFinite(n.y)) continue;
				minX = Math.min(minX, n.x); maxX = Math.max(maxX, n.x);
				minY = Math.min(minY, n.y); maxY = Math.max(maxY, n.y);
			}
			if (Number.isFinite(minX)) atlasBounds = { minX, minY, maxX, maxY };
		}

		function plateRect() {
			return { x: 26, y: 64, w: width - 52, h: height - 96 };
		}

		function inPlate(n) {
			const p = plateRect();
			const sx = n.x * cam.k + cam.x, sy = n.y * cam.k + cam.y;
			return sx >= p.x && sx <= p.x + p.w && sy >= p.y && sy <= p.y + p.h;
		}

		// baked paper texture — fibre specks, short fibre strokes, a two-tier
		// graticule with edge graduation ticks, and aged stains; drawn once
		// per resize onto an offscreen canvas and blitted each frame
		let paper = null;
		function seedPaper() {
			paper = document.createElement('canvas');
			paper.width = width;
			paper.height = height;
			const g = paper.getContext('2d');
			const rnd = mulberry32(7); // same paper across resizes
			const p = plateRect();
			g.save();
			g.beginPath();
			g.rect(p.x + 8, p.y + 8, p.w - 16, p.h - 16);
			g.clip();
			for (let i = 0; i < 2600; i++) {
				const x = p.x + rnd() * p.w, y = p.y + rnd() * p.h;
				g.fillStyle = `rgba(120, 95, 60, ${0.02 + rnd() * 0.04})`;
				g.fillRect(x, y, 1, 1);
			}
			for (let i = 0; i < 420; i++) {
				const x = p.x + rnd() * p.w, y = p.y + rnd() * p.h;
				const a = rnd() * Math.PI, l = 2 + rnd() * 5;
				g.strokeStyle = `rgba(120, 95, 60, ${0.03 + rnd() * 0.04})`;
				g.lineWidth = 1;
				g.beginPath();
				g.moveTo(x, y);
				g.lineTo(x + Math.cos(a) * l, y + Math.sin(a) * l);
				g.stroke();
			}
			// graticule — the two-tier lat/long mesh of an old chart: fine
			// 32px lines under a stronger 128px major mesh, hand-wobbled,
			// with pen-lift gaps erased at random below
			const gl = (x0, y0, x1, y1, seed) => {
				const horiz = y0 === y1;
				g.beginPath();
				const N = 48;
				for (let s = 0; s <= N; s++) {
					const t = s / N;
					const wob = Math.sin(t * 21 + seed) * 0.5 + Math.sin(t * 47 + seed * 2) * 0.3;
					const x = x0 + (x1 - x0) * t + (horiz ? 0 : wob);
					const y = y0 + (y1 - y0) * t + (horiz ? wob : 0);
					if (s) g.lineTo(x, y); else g.moveTo(x, y);
				}
				g.stroke();
			};
			g.lineWidth = 1;
			let gi = 0;
			for (let x = p.x + 32; x < p.x + p.w - 16; x += 32, gi++) {
				g.strokeStyle = `rgba(110, 88, 62, ${gi % 4 === 3 ? 0.18 : 0.09})`;
				gl(x, p.y + 9, x, p.y + p.h - 9, x * 0.7);
			}
			let gj = 0;
			for (let y = p.y + 32; y < p.y + p.h - 16; y += 32, gj++) {
				g.strokeStyle = `rgba(110, 88, 62, ${gj % 4 === 3 ? 0.18 : 0.09})`;
				gl(p.x + 9, y, p.x + p.w - 9, y, y * 0.7);
			}
			// edge graduation — the latitude scale ticks of a chart's border:
			// short ticks every 16px, long every 64px, on all four edges
			g.strokeStyle = 'rgba(110, 88, 62, 0.28)';
			for (let x = p.x + 16; x < p.x + p.w - 12; x += 16) {
				const l = (x - p.x) % 64 === 0 ? 8 : 4;
				g.beginPath(); g.moveTo(x, p.y + 9); g.lineTo(x, p.y + 9 + l); g.stroke();
				g.beginPath(); g.moveTo(x, p.y + p.h - 9); g.lineTo(x, p.y + p.h - 9 - l); g.stroke();
			}
			for (let y = p.y + 16; y < p.y + p.h - 12; y += 16) {
				const l = (y - p.y) % 64 === 0 ? 8 : 4;
				g.beginPath(); g.moveTo(p.x + 9, y); g.lineTo(p.x + 9 + l, y); g.stroke();
				g.beginPath(); g.moveTo(p.x + p.w - 9, y); g.lineTo(p.x + p.w - 9 - l, y); g.stroke();
			}
			g.globalCompositeOperation = 'destination-out';
			for (let i = 0; i < 90; i++) {
				const x = p.x + rnd() * p.w, y = p.y + rnd() * p.h;
				const horiz = rnd() < 0.5;
				const l = 6 + rnd() * 14;
				g.strokeStyle = `rgba(0, 0, 0, ${0.5 + rnd() * 0.5})`;
				g.lineWidth = 2;
				g.beginPath();
				g.moveTo(x, y);
				g.lineTo(horiz ? x + l : x, horiz ? y : y + l);
				g.stroke();
			}
			g.globalCompositeOperation = 'source-over';
			g.lineWidth = 1;
			for (const [fx, fy, fr] of [[0.24, 0.32, 110], [0.68, 0.6, 140], [0.42, 0.82, 80]]) {
				const sx = p.x + p.w * fx, sy = p.y + p.h * fy;
				const grad = g.createRadialGradient(sx, sy, 0, sx, sy, fr);
				grad.addColorStop(0, 'rgba(140, 110, 70, 0.05)');
				grad.addColorStop(1, 'rgba(140, 110, 70, 0)');
				g.fillStyle = grad;
				g.fillRect(p.x, p.y, p.w, p.h);
			}
			g.restore();
		}

		function drawAtlas(c) {
			const p = plateRect();
			const r = Math.min(p.w, p.h) * 0.055;
			const cx = p.x + p.w - r - 26, cy = p.y + r + 26;
			if (paper) ctx.drawImage(paper, 0, 0);
			// fold creases — a folded chart's signature: dark fold line with a
			// light catch on the raised side
			const crease = (x0, y0, x1, y1, dx, dy) => {
				ctx.strokeStyle = 'rgba(110, 88, 62, 0.07)';
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(x0, y0);
				ctx.lineTo(x1, y1);
				ctx.stroke();
				ctx.strokeStyle = 'rgba(255, 252, 240, 0.35)';
				ctx.beginPath();
				ctx.moveTo(x0 + dx, y0 + dy);
				ctx.lineTo(x1 + dx, y1 + dy);
				ctx.stroke();
			};
			const fx0 = p.x + p.w * 0.5, fy0 = p.y + p.h * 0.52;
			crease(fx0, p.y + 9, fx0, p.y + p.h - 9, 1, 0);
			crease(p.x + 9, fy0, p.x + p.w - 9, fy0, 0, 1);
			// double frame, hand-drawn with a soft deboss shadow
			const handRect = (x, y, w, h, seed) => {
				ctx.beginPath();
				const per = 2 * (w + h);
				const N = 96;
				for (let s = 0; s <= N; s++) {
					const d = (s / N) * per;
					const wob = Math.sin(d * 0.05 + seed) * 0.5 + Math.sin(d * 0.013 + seed * 2) * 0.6;
					let px, py;
					if (d < w) { px = x + d; py = y + wob; }
					else if (d < w + h) { px = x + w + wob; py = y + (d - w); }
					else if (d < 2 * w + h) { px = x + w - (d - w - h); py = y + h + wob; }
					else { px = x + wob; py = y + h - (d - 2 * w - h); }
					if (s) ctx.lineTo(px, py); else ctx.moveTo(px, py);
				}
				ctx.closePath();
				ctx.stroke();
			};
			ctx.save();
			ctx.shadowColor = 'rgba(110, 88, 62, 0.25)';
			ctx.shadowBlur = 2;
			ctx.shadowOffsetY = 1;
			ctx.strokeStyle = c.frame;
			ctx.lineWidth = 1.6;
			handRect(p.x, p.y, p.w, p.h, 3.1);
			ctx.restore();
			ctx.strokeStyle = c.frameIn;
			ctx.lineWidth = 0.8;
			handRect(p.x + 7, p.y + 7, p.w - 14, p.h - 14, 7.7);
			// scale bar, bottom-left
			const bx = p.x + 24, by = p.y + p.h - 26, bw = 140, seg = bw / 4;
			ctx.strokeStyle = c.scale;
			ctx.fillStyle = c.scale;
			ctx.lineWidth = 1;
			for (let i = 0; i < 4; i++) {
				if (i % 2 === 0) ctx.fillRect(bx + i * seg, by, seg, 5);
				else ctx.strokeRect(bx + i * seg + 0.5, by + 0.5, seg - 1, 4);
			}
			ctx.font = "italic 10px 'et-book', Georgia, serif";
			ctx.textAlign = 'right';
			ctx.textBaseline = 'bottom';
			ctx.fillText('leagues', bx + bw, by - 4);
			// compass rose: outer ring, four-point star, north tick
			ctx.strokeStyle = c.compass;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.arc(cx, cy, r, 0, Math.PI * 2);
			ctx.stroke();
			ctx.fillStyle = c.compass;
			const star = (rl, rw2) => {
				ctx.beginPath();
				for (let i = 0; i < 8; i++) {
					const ang = (i * Math.PI) / 4 - Math.PI / 2;
					const rad = i % 2 === 0 ? rl : rw2;
					const px = cx + Math.cos(ang) * rad, py = cy + Math.sin(ang) * rad;
					if (i) ctx.lineTo(px, py); else ctx.moveTo(px, py);
				}
				ctx.closePath();
				ctx.fill();
			};
			star(r * 0.86, r * 0.16);
			ctx.globalAlpha = 0.55;
			star(r * 0.42, r * 0.12);
			ctx.globalAlpha = 1;
			ctx.beginPath();
			ctx.moveTo(cx, cy - r * 0.86);
			ctx.lineTo(cx, cy - r * 1.18);
			ctx.stroke();
		}

		function drawLabels(c) {
			for (const n of nodes) {
				if (n.ghost || !inPlate(n)) continue; // place names live on the plate
				const deg = neighbors.get(n.id)?.size ?? 0;
				const isHub = deg >= 3;
				const isHover = hoverNode && n.id === hoverNode.id;
				const isNeighbor = hoverNode && neighbors.get(hoverNode.id)?.has(n.id);
				const dim = hoverNode && !isHover && !isNeighbor;
				const r = Math.max(nodeRadius(n), 1.2 / cam.k);
				ctx.globalAlpha = dim ? c.fade : 1;
				ctx.fillStyle = isHub ? c.labelHub : c.labelMinor;
				ctx.font = `${(isHub ? 13 : 11) / cam.k}px 'et-book', Georgia, serif`;
				ctx.textAlign = 'center';
				ctx.textBaseline = 'top';
				ctx.fillText(n.title, n.x, n.y + r + 5 / cam.k);
			}
			ctx.globalAlpha = 1;
		}
		let dust = [];
		let raf = 0, loopOn = false, loopRaf = 0;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const zoomPct = root.querySelector('.gv-zoom-pct');
		function setCamLabel() {
			if (zoomPct) zoomPct.textContent = Math.round(cam.k * 100) + '%';
		}

		const hint = root.querySelector('.sky-hint');
		function setHint() {
			if (!hint) return;
			hint.textContent = isDark()
				? 'drag a star · drag the sky to pan · scroll or pinch to zoom · click a star to open · esc to close'
				: 'drag a town · pan and zoom the map · click a town to open · esc to close';
		}

		function resize() {
			width = window.innerWidth;
			height = window.innerHeight;
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			canvas.style.width = width + 'px';
			canvas.style.height = height + 'px';
			seedDust();
			seedPaper();
			if (!touched || themeColors().map) fitToView(); // the plate always stays fitted
			if (sim) { refreshCollide(); sim.alpha(0.2).restart(); }
			schedule();
		}

		function schedule() {
			if (raf || loopOn) return; // the twinkle loop already paints every frame
			raf = requestAnimationFrame(() => { raf = 0; draw(performance.now()); });
		}

		function nodeRadius(n) {
			const base = n.ghost ? 1.5 : 2.0;
			const deg = neighbors.get(n.id)?.size ?? 0;
			return base + Math.sqrt(deg) * 1.0;
		}

		// label-aware collision: give each town a radius covering most of its
		// label at the fitted scale so place names never overprint
		function refreshCollide() {
			if (!sim || !cam.k) return;
			for (const n of nodes) {
				if (n.ghost) { n.lr = 0; continue; }
				const deg = neighbors.get(n.id)?.size ?? 0;
				ctx.font = `${(deg >= 3 ? 13 : 11) / cam.k}px 'et-book', Georgia, serif`;
				n.lr = ctx.measureText(n.title).width * 0.55 + 6 / cam.k;
			}
			sim.force('link', window.d3.forceLink(links).id((d) => d.id)
				.distance((l) => 70 + 0.55 * ((l.source.lr || 0) + (l.target.lr || 0)))
				.strength(0.25));
			sim.force('collide', window.d3.forceCollide((d) => Math.max(nodeRadius(d) + 3, d.lr || 0)).strength(1).iterations(3));
		}

		function hexA(a) {
			return Math.round(Math.min(1, Math.max(0, a)) * 255).toString(16).padStart(2, '0');
		}

		// Deterministic RNG so the dust field stays put across resizes/theme flips.
		function mulberry32(seed) {
			return () => {
				seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
				let z = Math.imul(seed ^ (seed >>> 15), 1 | seed);
				z = (z + Math.imul(z ^ (z >>> 7), 61 | z)) ^ z;
				return ((z ^ (z >>> 14)) >>> 0) / 4294967296;
			};
		}

		function seedDust() {
			if (!width || !height) return;
			const rnd = mulberry32(0x5eed);
			dust = [];
			const layers = [
				{ f: 0.12, density: 3200, size: 1.0, alpha: 0.14 },
				{ f: 0.30, density: 6800, size: 1.7, alpha: 0.26 },
			];
			for (const L of layers) {
				const count = Math.min(420, Math.round((width * height) / L.density));
				for (let i = 0; i < count; i++) {
					dust.push({
						x: rnd() * width, y: rnd() * height,
						s: 0.4 + rnd() * L.size,
						a: L.alpha * (0.35 + rnd() * 0.65),
						f: L.f,
						ph: rnd() * Math.PI * 2,
						sp: 0.25 + rnd() * 0.9,
					});
				}
			}
		}

		// Background stardust in screen space; each layer drifts with a hint of
		// parallax as the camera pans, wrapping at the viewport edges.
		function drawDust(c, now) {
			const t = now / 1000;
			ctx.fillStyle = c.dust;
			for (const d of dust) {
				const x = (((d.x + cam.x * d.f) % width) + width) % width;
				const y = (((d.y + cam.y * d.f) % height) + height) % height;
				ctx.globalAlpha = d.a * (reduced || c.map ? 1 : 0.7 + 0.3 * Math.sin(d.ph + d.sp * t));
				ctx.fillRect(x, y, d.s, d.s);
			}
			ctx.globalAlpha = 1;
		}

		// Twinkle loop: runs only while the overlay is open and the tab is
		// visible; one-shot redraws go through schedule().
		function setLoop(on) {
			if (reduced) on = false;
			if (on === loopOn) return;
			loopOn = on;
			if (on) loopRaf = requestAnimationFrame(loop);
			else cancelAnimationFrame(loopRaf);
		}

		function loop() {
			if (!loopOn) return;
			draw(performance.now());
			loopRaf = requestAnimationFrame(loop);
		}

		function draw(now) {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, width, height);
			const c = themeColors();
			drawDust(c, now);
			if (c.map) {
				drawAtlas(c); // the plate is a fixed screen-space picture frame
				const p = plateRect();
				ctx.save();
				ctx.beginPath();
				ctx.rect(p.x + 1, p.y + 1, p.w - 2, p.h - 2);
				ctx.clip(); // towns, roads and names never leave the frame
			}
			ctx.translate(cam.x, cam.y);
			ctx.scale(cam.k, cam.k);
			const hover = hoverNode || dragNode;
			const lw = (w) => w / cam.k; // constant screen-width strokes
			const t = now / 1000;

			// links — constellation lines
			for (const l of links) {
				const a = l.source, b = l.target;
				const active = hover && (a.id === hover.id || b.id === hover.id);
				const dim = hover && !active;
				ctx.globalAlpha = dim ? c.fade : 1;
				ctx.strokeStyle = active ? c.linkHi : c.link;
				ctx.lineWidth = lw(active ? 1.4 : 1);
				ctx.beginPath();
				ctx.moveTo(a.x, a.y);
				ctx.lineTo(b.x, b.y);
				ctx.stroke();
			}

			// nodes — stars in the night sky, towns on the atlas page; size by degree
			for (const n of nodes) {
				const isHover = hover && n.id === hover.id;
				const isNeighbor = hover && neighbors.get(hover.id)?.has(n.id);
				const dim = hover && !isHover && !isNeighbor;
				const live = !reduced && !c.map;
				const twSin = live ? Math.sin(n.twPhase + n.twSpeed * t) : 0;
				const tw = live ? 0.62 + 0.38 * twSin : 1;
				const breathe = live ? 0.82 + 0.18 * twSin : 1;
				const alpha = dim ? c.fade : 1;
				const r = Math.max(nodeRadius(n), 1.2 / cam.k); // stay visible when zoomed out
				if (n.ghost) {
					ctx.globalAlpha = alpha * tw;
					ctx.beginPath();
					ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
					ctx.strokeStyle = isHover ? c.linkHi : c.ghost;
					ctx.lineWidth = lw(1.2);
					ctx.stroke();
					continue;
				}
				const col = n.ci < 0 ? c.noGroup : c.stars[n.ci];
				const rr = r * (isHover ? 1.3 : breathe);
				// halo (night sky only — the atlas page keeps flat ink)
				if (c.haloA > 0) {
					const glowR = rr * (isHover ? 7 : 6);
					const g = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, glowR);
					g.addColorStop(0, col + hexA(c.haloA * alpha * tw));
					g.addColorStop(1, col + '00');
					ctx.globalAlpha = 1;
					ctx.fillStyle = g;
					ctx.beginPath();
					ctx.arc(n.x, n.y, glowR, 0, Math.PI * 2);
					ctx.fill();
				}
				// ink bleed on the atlas page: feathered soak around the core
				// plus a small offset blot, like ink in paper fibres
				if (c.map) {
					const bleed = rr * 2;
					const g2 = ctx.createRadialGradient(n.x, n.y, rr * 0.6, n.x, n.y, bleed);
					g2.addColorStop(0, col + hexA(0.3 * alpha));
					g2.addColorStop(1, col + '00');
					ctx.globalAlpha = 1;
					ctx.fillStyle = g2;
					ctx.beginPath();
					ctx.arc(n.x, n.y, bleed, 0, Math.PI * 2);
					ctx.fill();
					const ba = n.bleedA ?? (n.bleedA = Math.random() * Math.PI * 2);
					ctx.globalAlpha = alpha * 0.3;
					ctx.fillStyle = col;
					ctx.beginPath();
					ctx.arc(n.x + Math.cos(ba) * rr * 0.5, n.y + Math.sin(ba) * rr * 0.5, rr * 0.5, 0, Math.PI * 2);
					ctx.fill();
				}
				// core
				ctx.globalAlpha = alpha * (reduced ? 1 : 0.45 + 0.55 * tw);
				ctx.beginPath();
				ctx.arc(n.x, n.y, rr, 0, Math.PI * 2);
				ctx.fillStyle = col;
				ctx.fill();
				if (c.core) {
					ctx.globalAlpha = alpha * (0.5 + 0.4 * tw);
					ctx.beginPath();
					ctx.arc(n.x, n.y, rr * 0.45, 0, Math.PI * 2);
					ctx.fillStyle = c.core;
					ctx.fill();
				}
				if (isHover) {
					ctx.globalAlpha = 1;
					ctx.strokeStyle = c.label;
					ctx.lineWidth = lw(2);
					ctx.beginPath();
					ctx.arc(n.x, n.y, rr, 0, Math.PI * 2);
					ctx.stroke();
				}
			}
			if (c.map) {
				drawLabels(c);
				ctx.restore(); // release the plate clip
			}
			ctx.globalAlpha = 1;
		}

		function pick(x, y) {
			let best = null, bestD = Infinity;
			for (const n of nodes) {
				const dx = n.x - x, dy = n.y - y;
				const d = dx * dx + dy * dy;
				const r = nodeRadius(n) + 4 / cam.k; // constant screen-px tolerance
				if (d < r * r && d < bestD) { bestD = d; best = n; }
			}
			return best;
		}

		function toLocal(e) {
			const rect = canvas.getBoundingClientRect();
			return { x: e.clientX - rect.left, y: e.clientY - rect.top };
		}

		// Screen (canvas CSS px) → simulation world coordinates.
		function toWorld(e) {
			const p = toLocal(e);
			return { x: (p.x - cam.x) / cam.k, y: (p.y - cam.y) / cam.k };
		}

		// Zoom toward (px, py), keeping the world point under it fixed.
		function applyZoom(px, py, targetK) {
			const k = Math.min(K_MAX, Math.max(K_MIN, targetK));
			if (k === cam.k) return;
			const r = k / cam.k;
			cam.x = px - (px - cam.x) * r;
			cam.y = py - (py - cam.y) * r;
			cam.k = k;
			setCamLabel();
			schedule();
		}

		// Scale + translate so every node fits the viewport with padding.
		function fitToView(maxK = 1.5) {
			if (!nodes.length || !width || !height) return;
			const k0 = Number.isFinite(cam.k) && cam.k > 0 ? cam.k : 1;
			let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
			let used = 0;
			for (const n of nodes) {
				if (!Number.isFinite(n.x) || !Number.isFinite(n.y)) continue; // pre-tick
				used++;
				const r = Math.max(nodeRadius(n), 1.2 / k0);
				minX = Math.min(minX, n.x - r);
				minY = Math.min(minY, n.y - r);
				maxX = Math.max(maxX, n.x + r);
				maxY = Math.max(maxY, n.y + r);
			}
			if (!used) return;
			const bw = maxX - minX, bh = maxY - minY;
			if (bw <= 0 || bh <= 0) return;
			// the atlas plate wraps the layout in a frame + margin, so it needs
			// more breathing room than the bare constellation; center the fitted
			// content on the plate, not the raw viewport
			const m = themeColors().map ? 70 : 0;
			const bw2 = bw + 2 * m, bh2 = bh + 2 * m;
			const pad = 28;
			const k = Math.max(0.1, Math.min((width - pad * 2) / bw2, (height - pad * 2) / bh2, maxK));
			const p = plateRect();
			const cx = m ? p.x + p.w / 2 : width / 2;
			const cy = m ? p.y + p.h / 2 : height / 2;
			cam.k = k;
			cam.x = cx - (minX + bw / 2) * k;
			cam.y = cy - (minY + bh / 2) * k;
			setCamLabel();
			schedule();
		}

		function showTip(n, e) {
			if (!n) { tip.hidden = true; return; }
			tip.textContent = n.title;
			tip.hidden = false;
			tip.style.left = Math.min(e.clientX + 12, width - 10) + 'px';
			tip.style.top = Math.max(e.clientY - 12, 8) + 'px';
		}

		// --- open / close with the theme toggle's circular reveal -----------

		// Same mechanic as ThemeToggle: arm --vt-clip to a point before the
		// snapshot, then animate ::view-transition-new(root) open from the
		// star button. Hard swap when view transitions or motion are absent.
		function reveal(mutate) {
			const html = document.documentElement;
			const btn = document.getElementById('sky-toggle');
			const rect = btn?.getBoundingClientRect();
			const x = rect ? rect.left + rect.width / 2 : window.innerWidth - 40;
			const y = rect ? rect.top + rect.height / 2 : 40;
			const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
			const clip = (r) => `circle(${r}px at ${x}px ${y}px)`;
			if (!document.startViewTransition || reduced) { mutate(); return; }
			html.style.setProperty('--vt-clip', clip(0));
			const vt = document.startViewTransition(mutate);
			vt.ready.then(() => {
				html.animate(
					{ clipPath: [clip(0), clip(radius)] },
					{ duration: 500, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)', fill: 'forwards' },
				);
			}).catch(() => {});
			vt.finished.finally(() => html.style.removeProperty('--vt-clip'));
		}

		const isDark = () => document.documentElement.classList.contains('dark');

		function isOpen() { return !root.hidden; }

		function openSky() {
			start();
			if (!reduced) { jostle(); sim.alpha(0.7).restart(); }
			touched = false; // every reveal opens on the fitted plate
			reveal(() => {
				root.hidden = false;
				document.documentElement.classList.add('sky-open');
				document.body.style.overflow = 'hidden';
				fitToView();
			});
			setLoop(!document.hidden && isDark());
			setHint();
			document.dispatchEvent(new CustomEvent('sky:change', { detail: { open: true } }));
		}

		function closeSky() {
			reveal(() => {
				root.hidden = true;
				document.documentElement.classList.remove('sky-open');
				document.body.style.overflow = '';
				tip.hidden = true;
			});
			setLoop(false);
			sim?.stop();
			document.dispatchEvent(new CustomEvent('sky:change', { detail: { open: false } }));
		}

		document.addEventListener('sky:toggle', () => { isOpen() ? closeSky() : openSky(); }, { signal });
		root.querySelector('.sky-close').addEventListener('click', closeSky, { signal });
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen()) closeSky();
		}, { signal });
		document.addEventListener('visibilitychange', () => setLoop(isOpen() && !document.hidden && isDark()), { signal });

		// --- interactions ----------------------------------------------------

		canvas.addEventListener('pointermove', (e) => {
			// two-finger pinch zoom (touch)
			if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { cx: e.clientX, cy: e.clientY });
			if (pointers.size === 2) {
				const [a, b] = [...pointers.values()];
				const dist = Math.hypot(a.cx - b.cx, a.cy - b.cy);
				const rect = canvas.getBoundingClientRect();
				const mx = (a.cx + b.cx) / 2 - rect.left, my = (a.cy + b.cy) / 2 - rect.top;
				if (pinch.dist > 0) {
					applyZoom(pinch.mx, pinch.my, cam.k * (dist / pinch.dist)); // scale about old midpoint
					cam.x += mx - pinch.mx; // then follow the midpoint
					cam.y += my - pinch.my;
					touched = true;
					schedule();
				}
				pinch.dist = dist; pinch.mx = mx; pinch.my = my;
				return;
			}
			if (dragNode) {
				dragged = true;
				const { x, y } = toWorld(e);
				dragNode.fx = x; dragNode.fy = y;
				sim.alphaTarget(0.12).restart();
				schedule();
				return;
			}
			if (panning) {
				const p = toLocal(e);
				cam.x = panning.camX + (p.x - panning.startX);
				cam.y = panning.camY + (p.y - panning.startY);
				touched = true;
				tip.hidden = true;
				schedule();
				return;
			}
			const { x, y } = toWorld(e);
			const n = pick(x, y);
			if (n !== hoverNode) { hoverNode = n; schedule(); }
			canvas.style.cursor = n && !n.ghost ? 'pointer' : n ? 'default' : 'grab';
			showTip(n, e);
		}, { signal });

		canvas.addEventListener('pointerleave', () => {
			hoverNode = null; tip.hidden = true; schedule();
		}, { signal });

		canvas.addEventListener('pointerdown', (e) => {
			if (e.pointerType === 'touch') {
				pointers.set(e.pointerId, { cx: e.clientX, cy: e.clientY });
				if (pointers.size === 2) {
					// second finger: abandon any node drag / pan and start pinch
					if (dragNode) { dragNode.fx = null; dragNode.fy = null; dragNode = null; sim.alphaTarget(0); }
					panning = null;
					pinch.dist = 0;
					canvas.setPointerCapture(e.pointerId);
					return;
				}
				// single finger falls through: drag nodes / pan like the mouse
			}
			const { x, y } = toWorld(e);
			const n = pick(x, y);
			if (n) {
				dragNode = n; dragged = false;
				n.fx = n.x; n.fy = n.y;
			} else {
				const p = toLocal(e);
				panning = { startX: p.x, startY: p.y, camX: cam.x, camY: cam.y };
				canvas.style.cursor = 'grabbing';
			}
			canvas.setPointerCapture(e.pointerId);
		}, { signal });

		const endPointer = (e) => {
			pointers.delete(e.pointerId);
			if (pointers.size < 2) pinch.dist = 0;
			if (dragNode) {
				const n = dragNode;
				dragNode = null;
				n.fx = null; n.fy = null;
				touched = true;
				sim.alphaTarget(0);
				if (!dragged && n.url) window.location.href = n.url;
				return;
			}
			if (panning) {
				panning = null;
				canvas.style.cursor = 'grab';
			}
		};
		canvas.addEventListener('pointerup', endPointer, { signal });
		canvas.addEventListener('pointercancel', endPointer, { signal });

		canvas.addEventListener('wheel', (e) => {
			e.preventDefault();
			const p = toLocal(e);
			applyZoom(p.x, p.y, cam.k * Math.exp(-e.deltaY * 0.0016));
			touched = true;
		}, { passive: false, signal });

		canvas.addEventListener('dblclick', (e) => {
			const p = toLocal(e);
			applyZoom(p.x, p.y, cam.k * 1.6);
			touched = true;
		}, { signal });

		root.querySelector('.gv-zoom').addEventListener('click', (e) => {
			const btn = e.target.closest('[data-act]');
			if (!btn) return;
			const act = btn.dataset.act;
			if (act === 'fit') {
				touched = false;
				fitToView(2);
				return;
			}
			applyZoom(width / 2, height / 2, cam.k * (act === 'in' ? 1.35 : 1 / 1.35));
			touched = true;
		}, { signal });

		// Redraw when the theme class flips; re-jostle too so switching themes
		// mid-sky keeps the constellation alive, like the opening burst.
		// (sky-open toggles also mutate the class attribute — filtering on the
		// dark flag keeps those from double-triggering the jostle.)
		let wasDark = document.documentElement.classList.contains('dark');
		const mo = new MutationObserver(() => {
			const dark = document.documentElement.classList.contains('dark');
			if (dark !== wasDark) {
				wasDark = dark;
				if (isOpen() && !dark) { touched = false; fitToView(); } // re-plate the map
				if (isOpen()) setLoop(!document.hidden && dark);
				if (isOpen()) setHint();
			}
			schedule();
		});
		mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

		// Build the simulation lazily on first open so hidden pages pay nothing.
		function start() {
			if (started) return;
			started = true;
			resize();
			window.addEventListener('resize', resize, { signal });
			sim = window.d3.forceSimulation(nodes)
				.force('link', window.d3.forceLink(links).id((d) => d.id).distance(70).strength(0.35))
				.force('charge', window.d3.forceManyBody().strength(-160))
				.force('center', window.d3.forceCenter(width / 2, height / 2))
				.force('x', window.d3.forceX(width / 2).strength(0.04))
				.force('y', window.d3.forceY(height / 2).strength(0.06))
				.force('collide', window.d3.forceCollide((d) => nodeRadius(d) + 3))
				.stop();
			// Pre-settle the layout synchronously so the reveal already shows
			// the final arrangement, fitted inside the viewport; then re-settle
			// with label-aware collision so place names never overprint.
			sim.tick(300);
			buildAtlas();
			fitToView();
			refreshCollide();
			sim.alpha(0.4).tick(160);
			fitToView();
			sim.on('tick', schedule);
		}

		// Opening life: give the settled constellation a random shove so every
		// reveal shows a live settle back into place. Skipped under
		// prefers-reduced-motion — the sim simply stays stopped.
		function jostle() {
			const s = 160;
			for (const n of nodes) {
				n.vx += (Math.random() - 0.5) * s;
				n.vy += (Math.random() - 0.5) * s;
			}
		}

		signal.addEventListener('abort', () => {
			mo.disconnect();
			setLoop(false);
			sim?.stop();
			if (raf) cancelAnimationFrame(raf);
		});
	}

	onPage((signal) => {
		d3Ready().then(() => init(signal));
	});
</script>

