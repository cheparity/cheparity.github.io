---
import type { MarkdownHeading } from 'astro';

interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 4);
---

{headings.length > 0 && (
	<details id="outline" class="outline" open data-pagefind-ignore>
		<summary class="outline-title">Contents</summary>
		<nav class="outline-nav" aria-label="Table of contents">
			{headings.map(({ depth, slug, text }) => (
				<a class="outline-link" href={`#${encodeURIComponent(slug)}`} data-level={depth}>
					{text}
				</a>
			))}
		</nav>
	</details>
)}

<script>
	import { onPage } from '../utils/vt';

	onPage((signal) => {
		const outline = document.querySelector<HTMLDetailsElement>('#outline');
		const nav = outline?.querySelector<HTMLElement>('.outline-nav');
		if (!outline || !nav) return;

		const desktop = window.matchMedia('(min-width: 1200px)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const items = [...nav.querySelectorAll<HTMLAnchorElement>('a')].flatMap((link) => {
			const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
			return heading ? [{ link, heading }] : [];
		});
		if (!items.length) return;

		const syncDisclosure = () => { outline.open = desktop.matches; };
		syncDisclosure();
		desktop.addEventListener('change', syncDisclosure, { signal });
		outline.querySelector('summary')?.addEventListener('click', (event) => {
			if (desktop.matches) event.preventDefault();
		}, { signal });

		let activeId = '';
		function setActive(id: string) {
			if (activeId === id) return;
			activeId = id;
			for (const { link, heading } of items) {
				const active = heading.id === id;
				link.classList.toggle('is-active', active);
				if (active) {
					link.setAttribute('aria-current', 'location');
					if (desktop.matches) {
						const view = nav!.getBoundingClientRect();
						const row = link.getBoundingClientRect();
						if (row.top < view.top) nav!.scrollTop -= view.top - row.top;
						else if (row.bottom > view.bottom) nav!.scrollTop += row.bottom - view.bottom;
					}
				} else link.removeAttribute('aria-current');
			}
		}

		function goTo(heading: HTMLElement, event: MouseEvent) {
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			if (!desktop.matches) outline!.open = false;
			heading.scrollIntoView({ behavior: reducedMotion.matches ? 'instant' : 'smooth', block: 'start' });
			history.replaceState(null, '', `#${encodeURIComponent(heading.id)}`);
			setActive(heading.id);
		}

		for (const { link, heading } of items) {
			link.addEventListener('click', (event) => goTo(heading, event), { signal });
			heading.querySelector('.heading-anchor')?.remove();
			const anchor = document.createElement('a');
			anchor.className = 'heading-anchor';
			anchor.href = link.hash;
			anchor.setAttribute('aria-label', `Link to section: ${heading.textContent}`);
			anchor.textContent = '#';
			anchor.addEventListener('click', (event) => goTo(heading, event), { signal });
			heading.appendChild(anchor);
		}

		function computeActive() {
			let current = items[0].heading.id;
			for (const { heading } of items) {
				if (heading.getBoundingClientRect().top > 60) break;
				current = heading.id;
			}
			if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 5) {
				current = items[items.length - 1].heading.id;
			}
			setActive(current);
		}

		let frame = 0;
		const schedule = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => { frame = 0; computeActive(); });
		};
		window.addEventListener('scroll', schedule, { passive: true, signal });
		window.addEventListener('resize', schedule, { signal });
		signal.addEventListener('abort', () => cancelAnimationFrame(frame), { once: true });
		computeActive();
	});
</script>

<style is:global>
	.outline {
		outline: none;
		position: fixed;
		top: 10rem;
		left: max(var(--page-gutter), calc((100vw - var(--site-width)) / 2));
		width: var(--toc-width);
		font-family: 'et-book', 'Songti SC', serif;
		font-size: 14px;
		line-height: 1.55;
		color: var(--site-muted);
		z-index: 30;
	}
	.outline-title {
		margin-bottom: 0.8rem;
		color: var(--site-foreground);
		font-size: 1.2rem;
		list-style: none;
		cursor: default;
	}
	.outline-title::-webkit-details-marker { display: none; }
	.outline-nav {
		max-height: calc(100dvh - 15rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--site-border) transparent;
	}
	.outline a.outline-link {
		display: block;
		padding: 0.35rem 0.5rem 0.35rem 0.8rem;
		border-left: 1px solid var(--site-border);
		color: var(--site-muted);
		text-decoration: none;
		overflow-wrap: anywhere;
		transition: color 160ms ease, border-color 160ms ease;
	}
	.outline a[data-level="3"] { padding-left: 1.8rem; font-size: 0.95em; }
	.outline a[data-level="4"] { padding-left: 2.8rem; font-size: 0.9em; }
	.outline a.outline-link:hover,
	.outline a.outline-link.is-active {
		color: var(--site-accent);
		border-left-color: var(--site-accent);
	}
	.outline a.outline-link.is-active { font-weight: bold; }
	.outline :is(a, summary):focus-visible {
		outline: 2px solid var(--site-accent);
		outline-offset: -2px;
	}
	.prose :is(h2, h3, h4) { position: relative; scroll-margin-top: 3rem; }
	.heading-anchor {
		position: absolute;
		left: -1.2em;
		top: 0.35em;
		font-family: 'Source Sans 3', sans-serif;
		font-size: 0.65em;
		font-style: normal;
		text-decoration: none;
		opacity: 0;
	}
	.prose :is(h2, h3, h4):hover .heading-anchor,
	.heading-anchor:focus-visible { opacity: 1; }
	@media (max-width: 1199px) {
		.outline {
			position: static;
			width: var(--content-width);
			margin: 0.5rem 0 1.5rem;
			padding: 1rem 0;
			border-block: 1px solid var(--site-border);
		}
		.outline-title { cursor: pointer; margin: 0; }
		.outline-title::before { content: '▸'; display: inline-block; margin-right: 0.6rem; }
		.outline[open] .outline-title::before { transform: rotate(90deg); }
		.outline-nav { max-height: 45dvh; margin-top: 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.outline a.outline-link { transition: none; }
	}
</style>
