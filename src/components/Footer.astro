---
import { SITE_CONFIG } from '../config';

const { name, social } = SITE_CONFIG;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p class="footer-copy">&copy; {year} {name}</p>

		<nav class="footer-links" aria-label="Footer links">
			{
				social.github && (
					<a
						href={social.github}
						class="footer-link"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						title="GitHub"
					>
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
						</svg>
					</a>
				)
			}
			{
				social.email && (
					<a
						href={`mailto:${social.email}`}
						class="footer-link"
						aria-label="Email"
						title="Email"
					>
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect width="20" height="16" x="2" y="4" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
					</a>
				)
			}
			<a href="/rss.xml" class="footer-link" aria-label="RSS feed" title="RSS">
				<svg
					viewBox="0 0 24 24"
					width="18"
					height="18"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9" />
					<path d="M4 4a16 16 0 0 1 16 16" />
					<circle cx="5" cy="19" r="1" />
				</svg>
			</a>
		</nav>
	</div>
	<p class="footer-credit">
		Typeset in <em>et-book</em> · Built with
		<a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
	</p>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(128, 128, 128, 0.25);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-copy {
		margin: 0;
		font-family: 'et-book', serif;
		font-size: 1.1rem;
		color: #666;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		color: #777;
		background: rgba(128, 128, 128, 0.1);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease;
	}
	.footer-link:hover {
		transform: translateY(-2px);
		background: rgba(128, 128, 128, 0.22);
		color: inherit;
	}
	.footer-link:focus-visible {
		outline: 2px solid rgba(128, 128, 128, 0.5);
		outline-offset: 2px;
	}

	.footer-credit {
		margin: 1rem 0 0;
		font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		color: #999;
	}
	.footer-credit a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: rgba(128, 128, 128, 0.4);
		text-underline-offset: 0.15em;
		transition: text-decoration-color 0.2s ease;
	}
	.footer-credit a:hover {
		text-decoration-color: currentColor;
	}

	html.dark .footer-copy { color: #999; }
	html.dark .footer-credit { color: #777; }
	html.dark .site-footer { border-top-color: rgba(221, 221, 221, 0.2); }

	@media (max-width: 760px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
