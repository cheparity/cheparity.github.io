<!-- Inline script to prevent FOUC and set initial theme -->
<script is:inline data-cfasync="false" define:vars={{ defaultTheme: 'system' as const }}>
	(function() {
		const STORAGE_KEY = 'theme-preference';

		// Get stored theme or use default
		function getStoredTheme() {
			if (typeof localStorage === 'undefined') return null;
			try {
				return localStorage.getItem(STORAGE_KEY);
			} catch (e) {
				return null;
			}
		}

		// Get system theme preference
		function getSystemTheme() {
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}

		// Apply theme to html element only (button is managed by ThemeToggle)
		function applyTheme(theme) {
			const html = document.documentElement;
			if (theme === 'dark') {
				html.classList.add('dark');
			} else {
				html.classList.remove('dark');
			}
		}

		// Initialize immediately
		const storedTheme = getStoredTheme();
		if (storedTheme === 'light' || storedTheme === 'dark') {
			applyTheme(storedTheme);
		} else {
			// Fallback to system preference
			applyTheme(getSystemTheme());
		}

		// Astro copies the incoming page's root attributes during the swap.
		// Give that page the current theme before it becomes visible, so a
		// dark-to-dark navigation never takes a light snapshot.
		if (!window.__themeScriptWired) {
			window.__themeScriptWired = true;
			document.addEventListener('astro:before-swap', (event) => {
				event.newDocument.documentElement.classList.toggle(
					'dark',
					document.documentElement.classList.contains('dark')
				);
			});
			// Keep the page-load sync for initial loads and theme changes made
			// outside the toggle (for example, in another tab).
			document.addEventListener('astro:page-load', () => {
				const stored = getStoredTheme();
				applyTheme(stored === 'light' || stored === 'dark' ? stored : getSystemTheme());
			});
		}
	})();
</script>
