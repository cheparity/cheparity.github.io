---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ThemeScript from '../../components/ThemeScript.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import { readingMinutes } from '../../utils/readingTime';

export async function getStaticPaths() {
	const entries = (await getCollection('daily')).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
	);
	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			previous: index > 0 ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : undefined,
			next: index < entries.length - 1 ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : undefined,
		},
	}));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const readMins = readingMinutes(entry.id, 'daily');
---

<html lang="en">
	<head>
		<BaseHead title={`${entry.data.title} - Daily`} description={`${entry.data.title} · Daily note`} />
		<ThemeScript />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<section>
					<a class="back-link" href="/daily/">← Daily archive</a>
					<PostMeta pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} tags={entry.data.tags} readMins={readMins} />
					<h1>{entry.data.title}</h1>
					<hr />
				</section>
				<section class="prose"><Content /></section>
				<PostNavigation previous={previous} next={next} hrefBase="/daily" />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back-link { color: #777; text-decoration: none; font-size: 0.9rem; }
	.back-link:hover { text-decoration: underline; }
	:global(.date) { margin-top: 1.5rem; color: #888; }
</style>
