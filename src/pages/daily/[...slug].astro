---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { relatedPostsFor } from '../../utils/relatedPosts';

export async function getStaticPaths() {
	const entries = (await getCollection('daily')).sort(
		(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
	);
	return entries.map((entry, index) => ({
		params: { slug: entry.id },
		props: {
			entry,
			previous: index > 0 ? { id: entries[index - 1].id, title: entries[index - 1].data.title } : undefined,
			next: index < entries.length - 1 ? { id: entries[index + 1].id, title: entries[index + 1].data.title } : undefined,
		},
	}));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const relatedPosts = relatedPostsFor(entry, await getCollection('daily'));
---

<PostLayout collection="daily" {...entry.data} slug={entry.id} prevPost={previous} nextPost={next} relatedPosts={relatedPosts}>
	<Content />
</PostLayout>
