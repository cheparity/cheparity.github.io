---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Chronological neighbours for the prev/next navigation.
const all = (await getCollection('blog')).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const idx = all.findIndex((p) => p.id === post.id);
const prevPost =
	idx > 0 ? { id: all[idx - 1].id, title: all[idx - 1].data.title } : undefined;
const nextPost =
	idx < all.length - 1 ? { id: all[idx + 1].id, title: all[idx + 1].data.title } : undefined;

// Related posts: rank by shared-tag overlap, break ties by recency. Posts
// without tags never match, so the block simply doesn't render for them.
const ownTags = post.data.tags ?? [];
const relatedPosts =
	ownTags.length > 0
		? all
				.filter((p) => p.id !== post.id)
				.map((p) => ({
					id: p.id,
					title: p.data.title,
					tags: (p.data.tags ?? []).filter((t) => ownTags.includes(t)),
					pubDate: p.data.pubDate.valueOf(),
				}))
				.filter((p) => p.tags.length > 0)
				.sort(
					(a, b) =>
						b.tags.length - a.tags.length || b.pubDate - a.pubDate,
				)
				.slice(0, 3)
		: [];
---

<BlogPost {...post.data} slug={post.id} prevPost={prevPost} nextPost={nextPost} relatedPosts={relatedPosts}>
	<Content />
</BlogPost>
