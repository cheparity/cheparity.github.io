---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import TagIndex from "../../components/TagIndex.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of new Set(post.data.tags ?? [])) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) =>
  b[1] - a[1] || a[0].localeCompare(b[0]),
);

// Group newest-first into [year, posts] buckets for the archive.
const years: [number, typeof posts][] = [];
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  const last = years[years.length - 1];
  if (last && last[0] === year) last[1].push(post);
  else years.push([year, [post]]);
}
---

<html lang="en">
  <head>
    <BaseHead title={`${SITE_TITLE} - Blog`} description={SITE_DESCRIPTION} />
    <ThemeScript />
  </head>
  <body>
    <Header />

    <main>
      <article>
        <div class="blog-layout">
          <section class="intro">
            <h1>Blog</h1>
            <p>
              Writing on topics that matter. Thoughts, ideas, and explorations.
            </p>
            <p class="entry-count">{posts.length} posts</p>
          </section>

          {sortedTags.length > 0 && <div class="tag-rail"><TagIndex counts={sortedTags} /></div>}

          <section class="archive">
            {
              years.map(([year, yearPosts]) => (
                <div class="archive-year">
                  <h2 class="year-heading">{year}</h2>
                  {yearPosts.map((post) => (
                    <ArticleCard post={post} />
                  ))}
                </div>
              ))
            }
          </section>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
    column-gap: 3rem;
  }
  .intro { grid-column: 1; grid-row: 1; }
  .tag-rail { grid-column: 2; grid-row: 2; align-self: stretch; margin-top: 4rem; min-width: 0; }
  .archive {
    grid-column: 1;
    grid-row: 2;
    margin-top: 1rem;
    min-width: 0;
  }
  .archive :global(.article-text) { flex: 1 1 0; min-width: 0; }
  .archive :global(.article-content-wrapper) { flex-wrap: wrap; }

  .entry-count {
    color: #777;
    font-size: 0.95rem;
  }

  .year-heading {
    margin: 2.7rem 0 0.5rem;
    font-family: "et-book", serif;
    font-size: 1.9rem;
    font-weight: normal;
    font-variant-numeric: oldstyle-nums;
    color: #666;
  }

  .archive-year:first-child .year-heading {
    margin-top: 0;
  }

  html.dark .year-heading {
    color: #999;
  }
  @media (max-width: 900px) {
    .blog-layout { display: flex; flex-direction: column; }
    .tag-rail { margin-top: 0; }
  }
</style>
