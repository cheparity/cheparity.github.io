---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Outline from '../components/Outline.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Lightbox from '../components/Lightbox.astro';
import { readingMinutes } from '../utils/readingTime';
import { SITE_TITLE } from '../consts';

type PostLink = { title: string; id: string };
type RelatedPost = { title: string; id: string; tags: string[] };
type Props = CollectionEntry<'blog'>['data'] & {
	slug: string;
	prevPost?: PostLink;
	nextPost?: PostLink;
	relatedPosts?: RelatedPost[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, slug, prevPost, nextPost, relatedPosts } = Astro.props;
const readMins = readingMinutes(slug);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<ThemeScript />
	</head>

	<body>
		<ProgressBar />
		<Header />

		<main>
			<article>
				{heroImage && (
					<figure class="fullwidth">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</figure>
				)}
				<section>
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated-on">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)}
						<span class="read-time"> · {readMins} min read</span>
					</div>
					{tags && tags.length > 0 && (
						<div class="post-tags">
							{tags.map((tag) => (
								<a href={`/tags/${encodeURIComponent(tag)}/`} class="tag-pill tag-pill--sm">
									{tag}
								</a>
							))}
						</div>
					)}
					<h1>{title}</h1>
					<hr />
				</section>
				<section class="prose">
					<slot />
				</section>
				{(prevPost || nextPost) && (
					<nav class="post-nav" aria-label="Post navigation">
						{prevPost ? (
							<a href={`/blog/${prevPost.id}/`} class="post-nav-link post-nav-prev">
								<span class="post-nav-dir">← Previous</span>
								<span class="post-nav-title">{prevPost.title}</span>
							</a>
						) : (
							<span />
						)}
						{nextPost ? (
							<a href={`/blog/${nextPost.id}/`} class="post-nav-link post-nav-next">
								<span class="post-nav-dir">Next →</span>
								<span class="post-nav-title">{nextPost.title}</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)}
				{relatedPosts && relatedPosts.length > 0 && (
					<nav class="related" aria-label="Related posts">
						<span class="related-label">Related</span>
						<ul class="related-list">
							{relatedPosts.map((rel) => (
								<li>
									<a href={`/blog/${rel.id}/`} class="related-link">
										<span class="related-title">{rel.title}</span>
										<span class="related-tags">
											{rel.tags.map((tag) => (
												<span class="related-tag">#{tag}</span>
											))}
										</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)}
			</article>
		</main>
		<Outline />
		<Footer />
		<Lightbox />
	</body>
</html>

<style>
	.read-time {
		color: #666;
		font-style: italic;
	}
	html.dark .read-time {
		color: #999;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.9rem;
	}

	.post-nav {
		width: 60%;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid #ccc;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		font-family: 'et-book', serif;
	}
	html.dark .post-nav {
		border-top-color: rgba(221, 221, 221, 0.3);
	}

	.post-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease;
	}
	.post-nav-next {
		text-align: right;
		align-items: flex-end;
	}
	.post-nav-link:hover {
		transform: translateY(-2px);
	}

	.post-nav-dir {
		font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #999;
	}

	.post-nav-title {
		font-size: 1.3rem;
		font-style: italic;
		line-height: 1.3;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.15em;
		transition: text-decoration-color 0.2s ease;
	}
	.post-nav-link:hover .post-nav-title {
		text-decoration-color: currentColor;
	}

	/* Related posts — small-caps label in the Tufte chrome voice, then a
	   column of italic titles with their shared tags alongside. */
	.related {
		width: 60%;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid #ccc;
		font-family: 'et-book', serif;
	}
	html.dark .related {
		border-top-color: rgba(221, 221, 221, 0.3);
	}

	.related-label {
		display: block;
		font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #999;
		margin-bottom: 0.9rem;
	}

	.related-list {
		list-style: none;
		margin: 0;
		padding: 0;
		width: 100%;
	}

	.related-list li {
		margin: 0;
	}

	.related-link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.55rem 0;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid rgba(128, 128, 128, 0.15);
		transition: transform 0.2s ease;
	}
	.related-list li:last-child .related-link {
		border-bottom: none;
	}
	.related-link:hover {
		transform: translateX(4px);
	}

	.related-title {
		font-size: 1.3rem;
		font-style: italic;
		line-height: 1.3;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.15em;
		transition: text-decoration-color 0.2s ease;
	}
	.related-link:hover .related-title {
		text-decoration-color: currentColor;
	}

	.related-tags {
		display: flex;
		gap: 0.6rem;
		flex-shrink: 0;
		font-size: 0.95rem;
		color: #999;
	}
	html.dark .related-tags {
		color: #8a8578;
	}

	@media (max-width: 760px) {
		.related {
			width: 100%;
		}
		.related-link {
			flex-direction: column;
			gap: 0.2rem;
		}
	}

	@media (max-width: 760px) {
		.post-nav {
			width: 100%;
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.post-nav-next {
			text-align: left;
			align-items: flex-start;
		}
	}
</style>
